ref=/home/thh/nnp-vibrations/anharmonic/meoh/gaussian/modes


mkdir modes

n_atoms=$(grep -a atoms $1 | tr -s ' ' | cut -d ' ' -f 5)

n_dof=$(echo "$n_atoms*3" | bc)

n_modes=$(grep -a "^Vib-Modes" $1 | tr -s ' ' | cut -d ' ' -f 4)

echo $n_atoms "   " $n_dof "   " $n_modes

n_files=$(echo "$n_modes/3" | bc)

lines=$(echo "$n_modes/5" | bc)

rest=$(echo "$n_modes%5" | bc)

echo $n_files "  " $lines "  " $rest


if [ $rest -ne 0 ] 
then
  n_tail=$(echo "$lines+1" | bc)
else
  n_tail=$lines
fi


grep -a -A$n_tail "^Vib-Modes" $1 | tail -n $n_tail | gawk  '{printf("%20.14e\n%20.14e\n%20.14e\n%20.14e\n%20.14e\n", $1, $2, $3, $4, $5)}' | head -n $n_modes | gawk '
{
  a[NR] = $1;

}; END { 
  for (i=0; i < NR; i++)
  {

    printf("%20.14lf", a[i+1]);

    if ( ((i+1)%3) == 0)
    {
       printf("\n");
    }

  }
}' | awk 'NR%'$n_atoms'==1 { file = "modes/mode_" sprintf("%02d", NR/'$n_atoms'+1) } { print > file }'


lines=$(echo "$n_dof/5" | bc)

rest=$(echo "$n_dof%5" | bc)


if [ $rest -ne 0 ] 
then
  n_tail=$(echo "$lines+1" | bc)
else
  n_tail=$lines
fi


grep -a -A$n_tail Current $1 | grep -v Current | gawk '{printf("%24.16lf\n%24.16lf\n%24.16lf\n%24.16lf\n%24.16lf\n", $1, $2, $3, $4,$5)}' | gawk '{ count ++;  if (count <= '$n_dof') { printf("%24.16lf  ", $1*0.5291772086); if (count%3==0) {printf "\n"}} }' > modes/coords



### extract atomic masses

lines=$(echo "$n_atoms/5" | bc)

rest=$(echo "$n_atoms%5" | bc)


if [ $rest -ne 0 ] 
then
  n_tail=$(echo "$lines+1" | bc)
else
  n_tail=$lines
fi

grep -a -A$n_tail Mass $1 | grep -v Mass | gawk '{printf("%18.10lf\n%18.10lf\n%18.10lf\n%18.10lf\n%18.10lf\n", $1, $2, $3, $4,$5)}'| gawk '{ count ++;  if (count <= '$n_atoms') { printf("%24.16lf\n", $1)} }' > modes/atomic_masses


cd modes

# compute reduced masses
for i in $(ls mode_*)
do
   mode=$(echo $i | cut -d "_" -f2)
   paste $i atomic_masses | gawk '{sum = sum + $4*($1*$1+$2*$2+$3*$3) }; END {printf("%20.14lf\n", sum)}' > mass_$mode
done

# get lightest reduced mass
min=$(echo $(cat mass_* | sort -g | head -n1))

for i in $(ls mass_*)
do
    gawk '{printf ("%20.14lf   %20.14lf\n", $1, sqrt('$min'/$1) )}' $i > __temp__
    mv __temp__  $i
done



touch alignment_grid.dat alignment_max.dat
rm alignment_grid.dat alignment_max.dat

for file1 in $(ls mode_*)
do

  mode1=$(echo $file1 | rev | cut -d"_" -f1 | rev)
  
  norm1=$(echo $(gawk '{ sum += $1*$1+$2*$2+$3*$3;}; END { printf "%16.12f\n", sqrt(sum)}' $file1))

  max_mode=-1
  max_scalar=-1

  for file2 in $(ls $ref/mode_*)
  do
    scalar=0
    
    norm2=$(echo $(gawk '{ sum += $1*$1+$2*$2+$3*$3;}; END { printf "%16.12f\n", sqrt(sum)}' $file2))

    mode2=$(echo $file2 | rev | cut -d"_" -f1 | rev)
    
    scalar=$(echo $(paste $file1 $file2 | gawk '{ sum += $1*$4+$2*$5+$3*$6;}; END { printf "%16.12f\n", sqrt(sum*sum) / '$norm1' / '$norm2'}'))

    echo $mode1 "  " $mode2    "   " $scalar     >> alignment_grid.dat
    
    if (( $(echo "$scalar > $max_scalar" | bc -l ) )); then
       max_scalar=$scalar
       max_mode=$mode2
    fi

  done

  echo $mode1 "  " $max_mode "   " $max_scalar >> alignment_max.dat

done









